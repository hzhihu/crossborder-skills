# 本地开发数据库；请替换密码，不要提交真实凭据。
POSTGRES_DB=crossborder_skills
POSTGRES_USER=payload
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://payload:replace-with-a-local-password@localhost:5432/crossborder_skills

# Payload 与站点地址；请使用独立随机密钥。
PAYLOAD_SECRET=replace-with-a-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# 首页最近新增统计天数，默认 7，可调整为正整数。
HOME_RECENT_DAYS=7

# 仅用于本地首次管理员创建与登录验证，不用于公开注册。
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Worker 每分钟检查一次已创建任务，不会定时采集资源。
PAYLOAD_JOBS_CRON="* * * * *"

# 采集重试、请求超时和原始 Markdown 大小限制。
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_MS=30000
CRAWL_MAX_MARKDOWN_BYTES=1000000

# 媒体存储：开发和生产均可选择 local 或 s3。
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./media
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
