{
    "name": "crossborder-skills-hub",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "verify:phase2": "node scripts/verifyPhase2.ts",
        "verify:phase4": "node scripts/verifyPhase4.ts",
        "verify:phase5": "node scripts/verifyPhase5.ts",
        "payload": "payload --disable-transpile",
        "generate:importmap": "payload generate:importmap --disable-transpile",
        "generate:types": "payload generate:types --disable-transpile"
    },
    "dependencies": {
        "@payloadcms/db-postgres": "3.93.0",
        "@payloadcms/next": "3.93.0",
        "@payloadcms/richtext-lexical": "3.93.0",
        "@payloadcms/storage-s3": "3.93.0",
        "graphql": "16.15.0",
        "next": "16.4.5",
        "payload": "3.93.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-markdown": "10.1.0",
        "remark-gfm": "4.0.1"
    },
    "devDependencies": {
        "@playwright/test": "1.65.0",
        "@tailwindcss/postcss": "4.3.5",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitest/coverage-v8": "5.1.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.5",
        "shadcn": "4.23.0",
        "tailwindcss": "4.3.5",
        "typescript": "5.9.3",
        "vitest": "5.1.0"
    },
    "engines": {
        "node": ">=24.22.1"
    },
    "overrides": {
        "dompurify": "3.4.17",
        "happy-dom": "21.0.4"
    }
